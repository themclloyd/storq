root = true

# Prettier is configured with endOfLine: lf and .gitattributes normalizes to LF.
# Without this, Windows editors (and OneDrive sync) rewrite files as CRLF and
# every lint/format run fails on thousands of phantom line-ending errors.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
