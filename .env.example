SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_URL="https://your-project-id.supabase.co"
# Server-only secret. NEVER add the VITE_ prefix and never commit it. Required
# locally for payment verification (the complete_subscription_payment RPC is
# service_role-only). Injected automatically when connected to Lovable Cloud.
# From Dashboard -> Project Settings -> API -> 'service_role' secret.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Payment callbacks use window.location.origin automatically on Vercel/Cloudflare/etc.
# Only set VITE_SITE_URL if your platform cannot determine its own public origin.
# On Vercel/Cloudflare: leave empty.
VITE_SITE_URL=""

PAYCHANGU_PUBLIC_KEY="pub-..."
PAYCHANGU_SECRET_KEY="SEC-..."

# Cloudflare Turnstile (CAPTCHA) for sign-in / sign-up / password reset.
# CAPTCHA is ENABLED in Supabase Auth, so the credential flows require a token.
# The deployed site key is baked into src/lib/turnstile.ts as the default, so
# this value is OPTIONAL and only overrides it (e.g. to rotate to a new widget).
# The site key is public. The matching SECRET is NOT set here — it lives only in
# Supabase Auth settings, where the server redeems each token.
VITE_TURNSTILE_SITE_KEY=""
