# Copy to .env (never committed). Values come from Supabase → Project Settings → API.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"
SUPABASE_PROJECT_ID="<project-ref>"

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Public origin used for absolute canonical / og:url / og:image tags.
# Leave empty to fall back to relative canonicals (safe on any domain).
VITE_SITE_URL=""

# Server-only secrets. NEVER add these to a VITE_* variable and never commit them.
# SUPABASE_SERVICE_ROLE_KEY=""
# PAYCHANGU_PUBLIC_KEY=""
# PAYCHANGU_SECRET_KEY=""
